@echo off
rem Renders {{BLEND_NAME}} to PNG stills on every GPU at once, then encodes them with FFmpeg.
rem Generated by the blockbench-new-model skill. Safe to rerun: finished frames are skipped.
rem   render.cmd            render missing frames, then encode
rem   render.cmd encode     encode the existing frames only
setlocal EnableExtensions DisableDelayedExpansion

rem ---- Settings (edit freely) ------------------------------------------------
set "BLENDER={{BLENDER_EXE}}"
set "FFMPEG={{FFMPEG_EXE}}"
set "BLEND=%~dp0{{BLEND_RELATIVE}}"
set "WORKER=%~dp0render_worker.py"
set "FRAMES=%~dp0frames"
set "LOGS=%~dp0logs"
set "VIDEO=%~dp0{{VIDEO_NAME}}"
set "FPS={{FPS}}"
set "START_FRAME={{FRAME_START}}"
set "END_FRAME={{FRAME_END}}"
rem One worker per GPU. Set RENDER_GPUS=1 to use only the first GPU.
if not defined RENDER_GPUS set "RENDER_GPUS={{GPU_COUNT}}"
rem Leave empty to keep the samples saved in the .blend.
set "SAMPLES={{SAMPLES}}"
rem ---------------------------------------------------------------------------

set "SELF=%~f0"
set /a FRAME_COUNT=END_FRAME-START_FRAME+1
if /i "%~1"=="worker" goto worker
if /i "%~1"=="encode" goto encode

if not exist "%BLENDER%" (echo Blender not found: "%BLENDER%" & exit /b 1)
if not exist "%BLEND%" (echo Scene not found: "%BLEND%" & exit /b 1)
if not exist "%FRAMES%" mkdir "%FRAMES%"
if not exist "%LOGS%" mkdir "%LOGS%"
del /q "%LOGS%\*.done" 2>nul
call :find_missing

set /a LAST_GPU=RENDER_GPUS-1
echo Rendering frames %START_FRAME%-%END_FRAME% on %RENDER_GPUS% GPU worker(s). Logs: "%LOGS%"
for /l %%G in (0,1,%LAST_GPU%) do call :launch %%G

:wait
set "DONE=0"
for %%F in ("%LOGS%\*.done") do set /a DONE+=1
if %DONE% lss %RENDER_GPUS% (
  ping -n 11 127.0.0.1 >nul
  goto wait
)

call :find_missing
if defined MISSING (
  echo Some frames are missing. Re-rendering them on GPU 0...
  call :worker_run 0
  call :find_missing
)
if defined MISSING (echo Frames are still missing, first gap at %MISSING%. Check "%LOGS%". & exit /b 1)

:encode
if not exist "%FFMPEG%" (echo FFmpeg not found: "%FFMPEG%" & exit /b 1)
"%FFMPEG%" -hide_banner -y -framerate %FPS% -start_number %START_FRAME% -i "%FRAMES%\frame_%%04d.png" -frames:v %FRAME_COUNT% -vf "pad=ceil(iw/2)*2:ceil(ih/2)*2" -c:v libx264 -preset slow -crf 17 -pix_fmt yuv420p -movflags +faststart "%VIDEO%"
if errorlevel 1 (echo FFmpeg failed. & exit /b 1)
echo Wrote "%VIDEO%"
exit /b 0

:launch
rem "call" keeps the script path quoted, so folders with ( ) & ^ still work.
start "render gpu %~1" /min cmd /c call "%SELF%" worker %~1
rem Stagger start-up so the workers do not claim the same first frame.
ping -n 6 127.0.0.1 >nul
exit /b 0

:worker
call :worker_run %2
exit /b 0

:worker_run
set "GPU=%~1"
set "SAMPLE_ARG="
if defined SAMPLES set "SAMPLE_ARG=--samples %SAMPLES%"
"%BLENDER%" -b "%BLEND%" --python-exit-code 1 -P "%WORKER%" -a -- --gpu %GPU% --out "%FRAMES%" %SAMPLE_ARG% > "%LOGS%\gpu%GPU%.log" 2>&1
> "%LOGS%\gpu%GPU%.done" echo exit %errorlevel%
exit /b 0

:find_missing
rem Blender writes a 0-byte placeholder when a frame starts; a crash leaves it behind.
for %%F in ("%FRAMES%\frame_*.png") do if %%~zF equ 0 del "%%F"
set "MISSING="
for /l %%N in (%START_FRAME%,1,%END_FRAME%) do if not defined MISSING call :check_frame %%N
exit /b 0

:check_frame
set "PADDED=000%~1"
set "PADDED=%PADDED:~-4%"
if %~1 gtr 9999 set "PADDED=%~1"
if not exist "%FRAMES%\frame_%PADDED%.png" set "MISSING=%~1"
exit /b 0
